module api_server_startup

extends consts
import api/http

workflow startup {
  start: SetupCORS

  state SetupCORS {
    action api/http/http.SetupCORS() as CORSResult
    on success -> RegisterRoutes
    on fail -> Failed
  }

  state RegisterRoutes {
    action api/http/http.RegisterRoutes(
      modulesPath: $env.Config.application.modules_path,
      workflowsPath: $env.Config.application.workflows_path,
      version: $env.Config.application.version,
      buildTime: $env.Config.application.buildTime,
      groups: $routes
    ) as RouteResult
    on success -> StartServer
    on failure -> Failed
  }

  state StartServer {
    action api/http/http.StartServer(
      port: $args.port
    ) as ServerResult
    on success -> Running
    on failure -> Failed
  }

  state Running {
    action services/common/response.Response(
      value: "API Server running successfully",
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state Failed {
    action services/common/response.Response(
      value: "Failed to start API server",
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
