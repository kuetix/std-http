const {
    cors: {
        "AllowedMethods":   ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "AllowedHeaders":   ["Origin", "Content-Type", "Authorization", "sentry-trace", "baggage", "X-Requested-With", "Accept"],
        "ExposedHeaders":   ["Content-Length"],
        "AllowCredentials": true,
        "MaxAge":           12,
    },
    routes: {
        // Core endpoints
        "/health": [
            {
                "method": "GET",
                "workflow": "@solutions/api_server/endpoints/core/health",
                "description": "GET Health check endpoint",
                "require": {"qs": ["message"], "headers": ["Authorization"]}
            },
            {
                "method": "POST",
                "workflow": "@solutions/api_server/endpoints/core/health",
                "description": "POST Health check endpoint",
                "require": {"json": ["message"], "headers": ["Authorization"]}
            },
        ],
        "/health/{name}": [
            {
                "method": "GET",
                "workflow": "@solutions/api_server/endpoints/core/health",
                "description": "GET Health check endpoint",
                "require": {"qs": ["message"], "headers": ["Authorization"], "url": ["name"]}
            },
            {
                "method": "POST",
                "workflow": "@solutions/api_server/endpoints/core/health",
                "description": "POST Health check endpoint",
                "require": {"json": ["message"], "headers": ["Authorization"], "url": ["name"]}
            },
        ],
    }
}

